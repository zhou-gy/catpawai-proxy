{
  "name": "catpawai-proxy",
  "version": "0.1.0",
  "description": "Local OpenAI-compatible proxy for CatPawAI",
  "main": "clean/server.js",
  "scripts": {
    "start": "node clean/server.js",
    "dev": "node clean/server.js",
    "test": "node --test",
    "diagnose": "node scripts/diagnose.js",
    "configure-auth": "powershell -ExecutionPolicy Bypass -File scripts/configure-auth.ps1",
    "configure-from-catpaw-config": "powershell -ExecutionPolicy Bypass -File scripts/configure-from-catpaw-config.ps1",
    "import-from-catpaw-state": "node scripts/import-from-catpaw-state.js",
    "smoke": "node scripts/smoke.js"
  },
  "keywords": [
    "catpawai",
    "openai-compatible",
    "local-adapter"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
